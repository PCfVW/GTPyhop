Cell["R4. Where completeness stops, with the real tests", "Subsection",ExpressionUUID->"e3feb21c-6dcd-4620-bece-6cf9b434e92b"],

Cell["\<\
With the real tests p, q, r a test may repeat, which independence excludes. \
Every necessary literal the analysis misses, in bodies that can succeed, by \
cause:\
\>", "Text",ExpressionUUID->"9f1f514f-30ad-4570-8352-7a90f5129ffe"],

Cell[BoxData[
 RowBox[{"tbl", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<cause\>\"", ",", "\"\<literals missed\>\"", 
     ",", "\"\<smallest example\>\"", ",", "\"\<literal\>\""}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<a success return inside a loop, or the if inside \
one\>\"", ",", 
          RowBox[{"fmt", "[", 
           RowBox[{"Length", "[", "missLoop", "]"}], "]"}], ",", 
          RowBox[{"showP", "[", 
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           "]"}], ",", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"lit", "@@", "#1"}], ",", "InputForm"}], "]"}]}], "}"}], 
        "&"}], ")"}], "[", 
      RowBox[{"First", "[", 
       RowBox[{"SortBy", "[", 
        RowBox[{"missLoop", ",", "LeafCount"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<a test read twice on one path\>\"", ",", 
          RowBox[{"fmt", "[", 
           RowBox[{"Length", "[", "missRep", "]"}], "]"}], ",", 
          RowBox[{"showP", "[", 
           RowBox[{
           "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
           "]"}], ",", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"lit", "@@", "#1"}], ",", "InputForm"}], "]"}]}], "}"}], 
        "&"}], ")"}], "[", 
      RowBox[{"First", "[", 
       RowBox[{"SortBy", "[", 
        RowBox[{"missRep", ",", "LeafCount"}], "]"}], "]"}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<anything else\>\"", ",", 
       RowBox[{"fmt", "[", 
        RowBox[{
         RowBox[{"Length", "[", "missed", "]"}], "-", 
         RowBox[{"Length", "[", "missLoop", "]"}], "-", 
         RowBox[{"Length", "[", "missRep", "]"}]}], "]"}], 
       ",", "\"\<\[LongDash]\>\"", ",", "\"\<\[LongDash]\>\""}], "}"}]}], 
    "}"}]}], "]"}]], "Input",ExpressionUUID->"506b89ad-ba13-410a-9a82-\
fe23c9688b7e"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"cause\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"literals missed\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"smallest example\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"literal\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"a success return inside a loop, or the if inside one\"\>", \
"\<\"12,954\"\>", "\<\"{loop[{if[p, {}, {ok}]}]}\"\>", "\<\" !p\"\>"},
    {"\<\"a test read twice on one path\"\>", "\<\"11,352\"\>", "\<\"{if[p, \
{}, {if[p, {ok}, {ok}]}]}\"\>", "\<\" !p\"\>"},
    {"\<\"anything else\"\>", "\<\"0\"\>", "\<\"\[LongDash]\"\>", "\<\"\
\[LongDash]\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.9]}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
