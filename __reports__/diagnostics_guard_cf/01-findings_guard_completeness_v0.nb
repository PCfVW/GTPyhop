Cell["\<\
In the smallest, the if branch is empty (pass) and the action then falls off \
the end, returning None: success needs not p, yet no return False in the if \
says so.\
\>", "Text",ExpressionUUID->"63c7ee60-e123-4ac9-9732-e0b479826f8a"],

Cell["R5. What a reported atom guarantees", "Subsection",ExpressionUUID->"96edbd21-33b7-4dd0-aba8-36298176d390"],

Cell["\<\
Corollary (necessity). If a reported atom is false in some state, the action \
fails there, and it fails in every state where that atom stays false. Any \
repair must make it true; repairing anything else alone cannot suffice. This \
is soundness read from the consumer's side.\
\>", "Text",ExpressionUUID->"68a2ffaf-9be9-41c4-ae97-35b568a6fad4"],

Cell["\<\
Limit 1, one way only: fixing every reported atom does not ensure success. \
Here success needs p and (q or r), so R = {p}; with p true and q, r false \
every atom holds, yet the action fails.\
\>", "Text",ExpressionUUID->"fe5c39c7-d479-490a-9cf7-108e2eca589f"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"P", "=", 
     RowBox[{"number", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sIf", "[", 
         RowBox[{"p", ",", 
          RowBox[{"{", 
           RowBox[{
            RowBox[{"sIf", "[", 
             RowBox[{"q", ",", 
              RowBox[{"{", "ok", "}"}], ",", 
              RowBox[{"{", "}"}]}], "]"}], ",", 
            RowBox[{"sIf", "[", 
             RowBox[{"r", ",", 
              RowBox[{"{", "ok", "}"}], ",", 
              RowBox[{"{", "}"}]}], "]"}]}], "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", "bail"}], "}"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"showP", "[", "P", "]"}], ",", 
     RowBox[{"showReq", "[", 
      RowBox[{"P", ",", 
       RowBox[{"cur", "[", "P", "]"}]}], "]"}], ",", 
     RowBox[{
      RowBox[{"sem", "[", 
       RowBox[{"P", ",", "False"}], "]"}], "/.", "\[VeryThinSpace]", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"p", "\[Rule]", "True"}], ",", 
        RowBox[{"q", "\[Rule]", "False"}], ",", 
        RowBox[{"r", "\[Rule]", "False"}]}], "}"}]}]}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"c9ff1f84-34ff-4393-95ef-f7cf27cce96e"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"{if[p, {if[q, {ok}, {}], if[r, {ok}, {}]}, {}], bail}\"\>", ",", 
   TemplateBox[{"\"p\""},
    "RowDefault"], ",", "False"}], "}"}]], "Output",ExpressionUUID->"1b5c5bc9-\
9521-4b57-af71-959fe5d376d5"],

Cell["\<\
Limit 2, no list of atoms can be complete: when success needs one of two \
alternatives, no single literal is necessary. Here success is p or q, the \
only sound set of atoms is empty, and a complete explanation would have to \
say p \[Or] q.\
\>", "Text",ExpressionUUID->"851e9221-66df-49ad-8517-74d9891cf36c"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"P", "=", 
     RowBox[{"number", "[", 
      RowBox[{"{", 
       RowBox[{
        RowBox[{"sIf", "[", 
         RowBox[{"p", ",", 
          RowBox[{"{", "ok", "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", 
        RowBox[{"sIf", "[", 
         RowBox[{"q", ",", 
          RowBox[{"{", "ok", "}"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], ",", "bail"}], "}"}], "]"}]}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"showP", "[", "P", "]"}], ",", 
     RowBox[{"BooleanMinimize", "[", 
      RowBox[{"sem", "[", 
       RowBox[{"P", ",", "False"}], "]"}], "]"}], ",", 
     RowBox[{"cur", "[", "P", "]"}]}], "}"}]}], "]"}]], "Input",ExpressionUUID\
->"5718707e-3657-48c4-9e7f-2f2d262b43df"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{"\<\"{if[p, {ok}, {}], if[q, {ok}, {}], bail}\"\>", ",", 
   RowBox[{"p", "||", "q"}], ",", 
   RowBox[{"{", "}"}]}], "}"}]], "Output",ExpressionUUID->"954009df-937b-4ffe-\
a9bd-df9bf02099a5"],

Cell["\<\
Limit 3, outside the theorem: a missed necessary literal (R4) is as necessary \
as a reported one. Under the theorem's hypotheses there are none, and the \
split is exact: reported means necessary, unreported means some successful \
run does without it.\
\>", "Text",ExpressionUUID->"d25ecb5d-307c-465b-b1b9-3c9a9c1290e4"],

Cell["R6. The code computes the model", "Subsection",ExpressionUUID->"c4ab6401-dcd0-490d-8955-4ee6b46b4469"],

Cell["\<\
As round 00 R5, for the two latest readings: scripts/cf_agree.py renders \
every program as a Python action, runs extract_action_guards from dc3f852 and \
from caa3a1b, and compares their atoms with the model's (newReq and cur \
respectively).\
\>", "Text",ExpressionUUID->"75c0f1ab-d3fd-4e97-873f-10dedced8928"],

Cell[BoxData[
 RowBox[{"Module", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{
     RowBox[{"json", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{
        "$TemporaryDirectory", ",", "\"\<guard_r01_programs.json\>\""}], 
        "}"}], "]"}]}], ",", 
     RowBox[{"old", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"$TemporaryDirectory", ",", "\"\<guard_r01_old.py\>\""}], 
        "}"}], "]"}]}], ",", 
     RowBox[{"new", "=", 
      RowBox[{"FileNameJoin", "[", 
       RowBox[{"{", 
        RowBox[{"$TemporaryDirectory", ",", "\"\<guard_r01_new.py\>\""}], 
        "}"}], "]"}]}], ",", "res"}], "}"}], ",", 
   RowBox[{
    RowBox[{"Export", "[", 
     RowBox[{"json", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         RowBox[{"Association", "[", 
          RowBox[{
           RowBox[{"\"\<prog\>\"", "\[Rule]", 
            RowBox[{"toJ", "[", "#1", "]"}]}], ",", 
           RowBox[{"\"\<old\>\"", "\[Rule]", 
            RowBox[{"newReq", "[", "#1", "]"}]}], ",", 
           RowBox[{"\"\<new\>\"", "\[Rule]", 
            RowBox[{"cur", "[", "#1", "]"}]}]}], "]"}], "&"}], ")"}], "/@", 
       "progs"}], ",", "\"\<RawJSON\>\"", ",", 
      RowBox[{"\"\<Compact\>\"", "\[Rule]", "True"}]}], "]"}], ";", 
    RowBox[{"WriteString", "[", 
     RowBox[{"old", ",", 
      RowBox[{"RunProcess", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<git\>\"", ",", "\"\<-C\>\"", ",", "$repo", 
          ",", "\"\<show\>\"", 
          ",", "\"\<dc3f852:packages/gtpyhop-diagnostics/src/gtpyhop/\
diagnostics/guards.py\>\""}], "}"}], ",", "\"\<StandardOutput\>\""}], "]"}]}],
      "]"}], ";", 
    RowBox[{"Close", "[", "old", "]"}], ";", 
    RowBox[{"WriteString", "[", 
     RowBox[{"new", ",", 
      RowBox[{"RunProcess", "[", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{"\"\<git\>\"", ",", "\"\<-C\>\"", ",", "$repo", 
          ",", "\"\<show\>\"", 
          ",", "\"\<caa3a1b:packages/gtpyhop-diagnostics/src/gtpyhop/\
diagnostics/guards.py\>\""}], "}"}], ",", "\"\<StandardOutput\>\""}], "]"}]}],
      "]"}], ";", 
    RowBox[{"Close", "[", "new", "]"}], ";", 
    RowBox[{"res", "=", 
     RowBox[{"RunProcess", "[", 
      RowBox[{"{", 
       RowBox[{"\"\<python3\>\"", ",", "\"\<-S\>\"", ",", 
        RowBox[{"FileNameJoin", "[", 
         RowBox[{"{", 
          RowBox[{
          "$here", ",", "\"\<scripts\>\"", ",", "\"\<cf_agree.py\>\""}], 
          "}"}], "]"}], ",", "old", ",", "new", ",", "json"}], "}"}], "]"}]}],
     ";", 
    RowBox[{"DeleteFile", "[", 
     RowBox[{"{", 
      RowBox[{"json", ",", "old", ",", "new"}], "}"}], "]"}], ";", 
    RowBox[{"{", 
     RowBox[{
      RowBox[{"res", "[", "\"\<ExitCode\>\"", "]"}], ",", 
      RowBox[{"StringTrim", "[", 
       RowBox[{"res", "[", "\"\<StandardOutput\>\"", "]"}], "]"}]}], 
     "}"}]}]}], "]"}]], "Input",ExpressionUUID->"62e495e7-5f34-4d5c-bcdd-\
c1a04a1956cf"],

Cell[BoxData[
 RowBox[{"{", 
  RowBox[{
  "0", ",", "\<\"programs=94350 old_mismatches=0 new_mismatches=0\"\>"}], 
  "}"}]], "Output",ExpressionUUID->"7d1820b2-3427-435e-b3a2-ef3064eb4dff"],

Cell["Observations", "Section",ExpressionUUID->"20edc360-0178-4c98-bd36-0494e19f6a02"],

