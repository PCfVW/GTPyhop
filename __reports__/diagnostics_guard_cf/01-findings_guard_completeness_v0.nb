   GridBoxSpacings->{"Columns" -> {{1.2}}, "Rows" -> {{0.6}}}],
  "Grid"]], "Output",ExpressionUUID->"092db973-7c43-49d1-8ed4-e35cbe18e903"],

Cell["\<\
\"Anything else\" is 0, as the theorem predicts. Both causes have known \
remedies at a price: following loops needs dominance on a control-flow graph \
rather than one pass over the syntax tree, and correlated tests need a \
path-sensitive analysis, exponential in the worst case. In real domains a \
loop's guards usually read the loop variable, which no trace binds, so they \
could not be evaluated anyway.\
\>", "Text",ExpressionUUID->"7c7bee49-91fb-41c9-99b9-16c04e017545"],

Cell["\<\
The gap caa3a1b closes: literals the analysis proved but dc3f852's per-if \
reading dropped, all of them sound by R2.\
\>", "Text",ExpressionUUID->"4edfdb74-beb5-40d0-baeb-86e418b4e3d0"],

Cell[BoxData[
 RowBox[{"tbl", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<literals gained\>\"", ",", "\"\<in bodies\>\"", 
     ",", "\"\<smallest example\>\"", ",", "\"\<literal\>\""}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"(", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{
         RowBox[{"fmt", "[", 
          RowBox[{"Length", "[", "gained", "]"}], "]"}], ",", 
         RowBox[{"fmt", "[", 
          RowBox[{"Length", "[", 
           RowBox[{"DeleteDuplicates", "[", 
            RowBox[{"gained", "\[LeftDoubleBracket]", 
             RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], "]"}], 
           "]"}], "]"}], ",", 
         RowBox[{"showP", "[", 
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], "]"}],
          ",", 
         RowBox[{"ToString", "[", 
          RowBox[{
           RowBox[{"lit", "@@", "#1"}], ",", "InputForm"}], "]"}]}], "}"}], 
       "&"}], ")"}], "[", 
     RowBox[{"First", "[", 
      RowBox[{"SortBy", "[", 
       RowBox[{"gained", ",", "LeafCount"}], "]"}], "]"}], "]"}], "}"}]}], 
  "]"}]], "Input",ExpressionUUID->"47a43058-88aa-49d4-b93c-877d86072f2d"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"literals gained\"\>",
      StripOnInput->False,
