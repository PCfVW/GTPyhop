Cell[BoxData[
 RowBox[{
  RowBox[{"sem", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{
      RowBox[{"if", "[", 
       RowBox[{"i_", ",", "t_", ",", "A_", ",", "B_"}], "]"}], ",", 
