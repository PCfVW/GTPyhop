Cell["\<\
Red marks an atom the success condition does not imply. The first four shapes \
lose their atoms; the last two, which have a single path to success, keep \
every one.\
\>", "Text",ExpressionUUID->"34a0c2eb-a291-4808-b6f1-9e3de45c76e5"],

Cell["\<\
R2. Proof for every program, by induction on the statement list\
\>", "Subsection",ExpressionUUID->"c03b6890-80b2-4cee-8737-25810ac2c166"],

Cell["\<\
Invariant Inv(f, {mayOk, R}) for a block whose success condition is f: f \
implies every literal in R, and if mayOk is False then f is unsatisfiable. \
The analysis computes a block's result from its first statement and the \
result for the rest, so it suffices that each clause preserves Inv, given Inv \
for the children (IH). R is a set, and f \[DoubleLongRightArrow] And(R) holds \
literal by literal, so one representative literal per set is enough: x common \
to both branches, ra and rb in one only, rk from the continuation.\
\>", "Text",ExpressionUUID->"e0f310bf-1cd0-4927-bd5e-fd9b0ca017f1"],

Cell[BoxData[
 RowBox[{"tbl", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<clause\>\"", ",", "\"\<obligation\>\"", 
     ",", "\"\<result\>\""}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<return state\>\"", 
       ",", "\"\<sem = True, result {True, {}}\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{"inv", "[", 
           RowBox[{"True", ",", "True", ",", 
            RowBox[{"{", "}"}]}], "]"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<return False / raise\>\"", 
       ",", "\"\<sem = False, result {False, {}}\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{"inv", "[", 
           RowBox[{"False", ",", "False", ",", 
            RowBox[{"{", "}"}]}], "]"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<effect, anything that falls through\>\"", 
       ",", "\"\<sem = k, result = K\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"inv", "[", 
            RowBox[{"k", ",", "okK", ",", 
             RowBox[{"{", "rk", "}"}]}], "]"}], "\[Implies]", 
           RowBox[{"inv", "[", 
            RowBox[{"k", ",", "okK", ",", 
             RowBox[{"{", "rk", "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"k", ",", "okK", ",", "rk"}], "}"}]}], "]"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<if, both branches cannot succeed\>\"", 
       ",", "\"\<result {False, {}}\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"inv", "[", 
             RowBox[{"a", ",", "False", ",", 
              RowBox[{"{", "ra", "}"}]}], "]"}], "&&", 
            RowBox[{"inv", "[", 
             RowBox[{"b", ",", "False", ",", 
              RowBox[{"{", "rb", "}"}]}], "]"}]}], "\[Implies]", 
           RowBox[{"inv", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"t", "&&", "a"}], ")"}], "||", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"!", "t"}], "&&", "b"}], ")"}]}], ",", "False", ",", 
             RowBox[{"{", "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "a", ",", "b", ",", "ra", ",", "rb"}], "}"}]}], 
         "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<if, body cannot succeed\>\"", 
       ",", "\"\<result {True, R_B \[Union] {!t}}\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"inv", "[", 
             RowBox[{"a", ",", "False", ",", 
              RowBox[{"{", "ra", "}"}]}], "]"}], "&&", 
            RowBox[{"inv", "[", 
             RowBox[{"b", ",", "True", ",", 
              RowBox[{"{", "rb", "}"}]}], "]"}]}], "\[Implies]", 
           RowBox[{"inv", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"t", "&&", "a"}], ")"}], "||", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"!", "t"}], "&&", "b"}], ")"}]}], ",", "True", ",", 
             RowBox[{"{", 
              RowBox[{"rb", ",", 
               RowBox[{"!", "t"}]}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "a", ",", "b", ",", "ra", ",", "rb"}], "}"}]}], 
         "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<if, else cannot succeed\>\"", 
       ",", "\"\<result {True, R_A \[Union] {t}}\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"inv", "[", 
             RowBox[{"a", ",", "True", ",", 
              RowBox[{"{", "ra", "}"}]}], "]"}], "&&", 
            RowBox[{"inv", "[", 
             RowBox[{"b", ",", "False", ",", 
              RowBox[{"{", "rb", "}"}]}], "]"}]}], "\[Implies]", 
           RowBox[{"inv", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"t", "&&", "a"}], ")"}], "||", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"!", "t"}], "&&", "b"}], ")"}]}], ",", "True", ",", 
             RowBox[{"{", 
              RowBox[{"ra", ",", "t"}], "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "a", ",", "b", ",", "ra", ",", "rb"}], "}"}]}], 
         "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<if, both may succeed\>\"", 
       ",", "\"\<result {True, R_A \[Intersection] R_B}\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"inv", "[", 
             RowBox[{"a", ",", "True", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "ra"}], "}"}]}], "]"}], "&&", 
            RowBox[{"inv", "[", 
             RowBox[{"b", ",", "True", ",", 
              RowBox[{"{", 
               RowBox[{"x", ",", "rb"}], "}"}]}], "]"}]}], "\[Implies]", 
           RowBox[{"inv", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"t", "&&", "a"}], ")"}], "||", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"!", "t"}], "&&", "b"}], ")"}]}], ",", "True", ",", 
             RowBox[{"{", "x", "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "a", ",", "b", ",", "x", ",", "ra", ",", "rb"}], 
           "}"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<compound with a success return inside\>\"", 
       ",", "\"\<result {True, {}}\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{"inv", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"(", 
              RowBox[{"cc", "&&", "a"}], ")"}], "||", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{"!", "cc"}], "&&", "k"}], ")"}]}], ",", "True", ",", 
            RowBox[{"{", "}"}]}], "]"}], ",", 
          RowBox[{"{", 
           RowBox[{"cc", ",", "a", ",", "k"}], "}"}]}], "]"}], "]"}]}], "}"}],
      ",", 
     RowBox[{"{", 
      RowBox[{"\"\<compound without one\>\"", 
       ",", "\"\<result = K, by the lemma a \[DoubleLongRightArrow] k\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"a", "\[Implies]", "k"}], ")"}], "&&", 
            RowBox[{"inv", "[", 
             RowBox[{"k", ",", "okK", ",", 
              RowBox[{"{", "rk", "}"}]}], "]"}]}], "\[Implies]", 
           RowBox[{"inv", "[", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"cc", "&&", "a"}], ")"}], "||", 
              RowBox[{"(", 
               RowBox[{
                RowBox[{"!", "cc"}], "&&", "k"}], ")"}]}], ",", "okK", ",", 
             RowBox[{"{", "rk", "}"}]}], "]"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"cc", ",", "a", ",", "k", ",", "okK", ",", "rk"}], "}"}]}],
          "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<lemma: no success return \[DoubleLongRightArrow] a \
\[DoubleLongRightArrow] k\>\"", 
       ",", "\"\<bail, fall-through, if and loop (IH on the parts)\>\"", ",", 
       
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{
           RowBox[{"(", 
            RowBox[{"False", "\[Implies]", "k"}], ")"}], "&&", 
           RowBox[{"(", 
            RowBox[{"k", "\[Implies]", "k"}], ")"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{
              RowBox[{"(", 
               RowBox[{"a", "\[Implies]", "k"}], ")"}], "&&", 
              RowBox[{"(", 
               RowBox[{"b", "\[Implies]", "k"}], ")"}]}], "\[Implies]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"t", "&&", "a"}], ")"}], "||", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"!", "t"}], "&&", "b"}], ")"}]}], "\[Implies]", 
               "k"}], ")"}]}], ")"}], "&&", 
           RowBox[{"(", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{"a", "\[Implies]", "k"}], ")"}], "\[Implies]", 
             RowBox[{"(", 
              RowBox[{
               RowBox[{
                RowBox[{"(", 
                 RowBox[{"cc", "&&", "a"}], ")"}], "||", 
                RowBox[{"(", 
                 RowBox[{
                  RowBox[{"!", "cc"}], "&&", "k"}], ")"}]}], "\[Implies]", 
               "k"}], ")"}]}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"t", ",", "a", ",", "b", ",", "cc", ",", "k"}], "}"}]}], 
         "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<end of the function\>\"", 
       ",", "\"\<K0 = {False, {}} for k = False\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{"inv", "[", 
           RowBox[{"False", ",", "False", ",", 
            RowBox[{"{", "}"}]}], "]"}], ",", 
          RowBox[{"{", "}"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<filter, then split\>\"", 
       ",", "\"\<kept \[SubsetEqual] R, and round 00 R2: requirement \
\[DoubleLongRightArrow] each atom\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"(", 
             RowBox[{"s", "\[Implies]", "l"}], ")"}], "&&", 
            RowBox[{"(", 
             RowBox[{"l", "\[Implies]", "at"}], ")"}]}], "\[Implies]", 
           RowBox[{"(", 
            RowBox[{"s", "\[Implies]", "at"}], ")"}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s", ",", "l", ",", "at"}], "}"}]}], "]"}], "]"}]}], 
      "}"}]}], "}"}]}], "]"}]], "Input",ExpressionUUID->"3ce75f99-1428-4e7b-\
b28f-bcac846c403c"],

