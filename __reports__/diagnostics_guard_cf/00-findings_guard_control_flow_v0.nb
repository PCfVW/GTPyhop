Cell["\<\
Every action body of up to 6 statements (size) over three tests, each checked \
over every assignment of the tests and of each loop's run-or-not. walk and \
path: atoms from the ast.walk reading (0.1.1) and the path-aware one \
(dc3f852), each followed by how many of them the success condition does not \
imply, by truth table. R unsound: literals in the analysis' whole set R that \
are not implied. no-ok wrong: programs the analysis says cannot succeed but \
can. added: programs where the fix has an atom the old reading lacked.\
\>", "Text",ExpressionUUID->"db393e1a-6d54-46c2-aeaf-af690dbbfc42"],

Cell["R4. Precision: what the fix gives up", "Subsection",ExpressionUUID->"6f6dba9b-879b-4023-a32b-ee7f22f59993"],

Cell["\<\
A dropped atom is a loss only if it was sound and the action can succeed (in \
a program that never succeeds every atom is vacuously sound).\
\>", "Text",ExpressionUUID->"404e8d0e-3c97-4d8d-959c-96d6c431a63a"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"lost", "=", 
     RowBox[{"Join", "@@", 
      RowBox[{
       RowBox[{"Function", "[", 
        RowBox[{"P", ",", 
         RowBox[{"If", "[", 
          RowBox[{
           RowBox[{"satisfiable", "[", "P", "]"}], ",", 
           RowBox[{
            RowBox[{"(", 
             RowBox[{
              RowBox[{"{", 
               RowBox[{"P", ",", "#1"}], "}"}], "&"}], ")"}], "/@", 
            RowBox[{"necessary", "[", 
             RowBox[{"P", ",", 
              RowBox[{"Complement", "[", 
               RowBox[{
                RowBox[{"oldReq", "[", "P", "]"}], ",", 
                RowBox[{"newReq", "[", "P", "]"}]}], "]"}]}], "]"}]}], ",", 
           RowBox[{"{", "}"}]}], "]"}]}], "]"}], "/@", "progs"}]}]}], "}"}], ",", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{
       RowBox[{"inside", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"lost", ",", 
          RowBox[{
           RowBox[{"inLoop", "[", 
            RowBox[{
             RowBox[{
             "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
             RowBox[{"#1", "\[LeftDoubleBracket]", 
              RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}], 
           "&"}]}], "]"}]}], ",", 
       RowBox[{"rep", "=", 
        RowBox[{"Select", "[", 
         RowBox[{"lost", ",", 
          RowBox[{
           RowBox[{
            RowBox[{"!", 
             RowBox[{"inLoop", "[", 
              RowBox[{
               RowBox[{
               "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
               RowBox[{"#1", "\[LeftDoubleBracket]", 
                RowBox[{"2", ",", "1"}], "\[RightDoubleBracket]"}]}], "]"}]}],
             "&&", 
            RowBox[{"repeats", "[", 
             RowBox[{
             "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
             "]"}]}], "&"}]}], "]"}]}]}], "}"}], ",", 
     RowBox[{"tbl", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<sound atoms the fix drops, in bodies that can \
succeed\>\"", ",", "\"\<count\>\"", ",", "\"\<smallest example\>\"", 
         ",", "\"\<atom dropped\>\""}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<if inside a loop\>\"", ",", 
              RowBox[{"Length", "[", "inside", "]"}], ",", 
              RowBox[{"showP", "[", 
               RowBox[{
               "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "]"}], ",", 
              RowBox[{"ToString", "[", 
               RowBox[{
                RowBox[{"lit", "@@", "#1"}], ",", "InputForm"}], "]"}]}], 
             "}"}], "&"}], ")"}], "[", 
          RowBox[{"First", "[", 
           RowBox[{"SortBy", "[", 
            RowBox[{"inside", ",", "LeafCount"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{
          RowBox[{"(", 
           RowBox[{
            RowBox[{"{", 
             RowBox[{"\"\<a test repeated on the path\>\"", ",", 
              RowBox[{"Length", "[", "rep", "]"}], ",", 
              RowBox[{"showP", "[", 
               RowBox[{
               "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], 
               "]"}], ",", 
              RowBox[{"ToString", "[", 
               RowBox[{
                RowBox[{"lit", "@@", "#1"}], ",", "InputForm"}], "]"}]}], 
             "}"}], "&"}], ")"}], "[", 
          RowBox[{"First", "[", 
           RowBox[{"SortBy", "[", 
            RowBox[{"rep", ",", "LeafCount"}], "]"}], "]"}], "]"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<anything else\>\"", ",", 
           RowBox[{
            RowBox[{"Length", "[", "lost", "]"}], "-", 
            RowBox[{"Length", "[", "inside", "]"}], "-", 
            RowBox[{"Length", "[", "rep", "]"}]}], ",", "\"\<\[LongDash]\>\"",
            ",", "\"\<\[LongDash]\>\""}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<vacuous (the body never succeeds), for comparison\>\"",
            ",", 
           RowBox[{
            RowBox[{
            "totals", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], 
            "-", 
            RowBox[{
            "totals", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], 
            "-", 
            RowBox[{
            "totals", "\[LeftDoubleBracket]", "4", "\[RightDoubleBracket]"}], 
            "-", 
            RowBox[{"Length", "[", "lost", "]"}]}], ",", "\"\<\>\"", 
           ",", "\"\<\>\""}], "}"}]}], "}"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",ExpressionUUID->"e146d16a-8858-4b11-a301-630c6f121431"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"sound atoms the fix drops, in bodies that can succeed\"\>",
      
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"count\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"smallest example\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"atom dropped\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"if inside a loop\"\>", 
     "2193", "\<\"{loop[{if[2, p, {bail}, {ok}]}]}\"\>", "\<\" !p\"\>"},
    {"\<\"a test repeated on the path\"\>", 
     "1326", "\<\"{if[p, {ok}, {if[2, p, {}, {bail}]}]}\"\>", "\<\"p\"\>"},
    {"\<\"anything else\"\>", 
     "0", "\<\"\[LongDash]\"\>", "\<\"\[LongDash]\"\>"},
