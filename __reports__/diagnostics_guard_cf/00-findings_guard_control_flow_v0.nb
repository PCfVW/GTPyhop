    {"\<\"atoms added\"\>", "\<\"0: the fix only filters\"\>", "\<\"0 \
[R3]\"\>", "\<\"no new or reworded atom can appear\"\>"},
    {"\<\"model vs code\"\>", "\<\"agree on every program\"\>", "\<\"0 \
mismatches, both readings [R5]\"\>", "\<\"the proof is about the shipped \
guards.py\"\>"},
    {"\<\"precision cost\"\>", "\<\"small\"\>", "\<\"every non-vacuous loss \
is inside a loop or on a repeated test [R4]\"\>", "\<\"the price of reading \
nothing inside a loop, and of treating tests as independent\"\>"},
    {"\<\"bundled examples\"\>", "\<\"estimate: 11 actions, 13 atoms\"\>", \
"\<\"12 actions, 16 atoms; recognition 330 of 335 unchanged\"\>", "\<\"the \
estimate missed early success returns and else branches\"\>"},
    {"\<\"consumer corpus\"\>", "\<\"estimate: 27 actions, 53 atoms\"\>", "\<\
\"50 actions, 105 atoms; recognition 5,808 \[RightArrow] 5,807\"\>", "\<\"the \
lost action's only atom read a loop variable and was never evaluable\"\>"}
   },
