Cell[BoxData[
 RowBox[{
  RowBox[{"ex2", "[", "n_", "]"}], ":=", 
  RowBox[{
   RowBox[{"ex2", "[", "n", "]"}], "=", 
   RowBox[{"DeleteDuplicates", "[", 
    RowBox[{"Join", "[", 
     RowBox[{
      RowBox[{"not", "/@", 
       RowBox[{"ex2", "[", 
        RowBox[{"n", "-", "1"}], "]"}]}], ",", 
      RowBox[{"Join", "@@", 
       RowBox[{"Table", "[", 
        RowBox[{
         RowBox[{"Join", "@@", 
          RowBox[{
           RowBox[{"(", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"and", "@@", "#1"}], ",", 
               RowBox[{"or", "@@", "#1"}]}], "}"}], "&"}], ")"}], "/@", 
           RowBox[{"Tuples", "[", 
            RowBox[{"{", 
             RowBox[{
              RowBox[{"ex2", "[", "k", "]"}], ",", 
              RowBox[{"ex2", "[", 
               RowBox[{"n", "-", "1", "-", "k"}], "]"}]}], "}"}], "]"}]}]}], ",", 
         RowBox[{"{", 
          RowBox[{"k", ",", "1", ",", 
           RowBox[{"n", "-", "2"}]}], "}"}]}], "]"}]}], ",", 
      RowBox[{"If", "[", 
       RowBox[{
        RowBox[{"n", "\[GreaterEqual]", "4"}], ",", 
        RowBox[{"Join", "@@", 
         RowBox[{"Flatten", "[", 
          RowBox[{
           RowBox[{"Table", "[", 
            RowBox[{
             RowBox[{"Join", "@@", 
              RowBox[{
               RowBox[{"(", 
                RowBox[{
                 RowBox[{"{", 
                  RowBox[{
                   RowBox[{"and", "@@", "#1"}], ",", 
                   RowBox[{"or", "@@", "#1"}]}], "}"}], "&"}], ")"}], "/@", 
               RowBox[{"Tuples", "[", 
                RowBox[{"{", 
                 RowBox[{
                  RowBox[{"ex2", "[", "i", "]"}], ",", 
                  RowBox[{"ex2", "[", "j", "]"}], ",", 
                  RowBox[{"ex2", "[", 
                   RowBox[{"n", "-", "1", "-", "i", "-", "j"}], "]"}]}], 
                 "}"}], "]"}]}]}], ",", 
             RowBox[{"{", 
              RowBox[{"i", ",", "1", ",", 
               RowBox[{"n", "-", "3"}]}], "}"}], ",", 
             RowBox[{"{", 
              RowBox[{"j", ",", "1", ",", 
               RowBox[{"n", "-", "2", "-", "i"}]}], "}"}]}], "]"}], ",", 
           "1"}], "]"}]}], ",", 
        RowBox[{"{", "}"}]}], "]"}]}], "]"}], "]"}]}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"6aefeb76-26fa-4ca2-ba4c-e3faf8496cac"],

Cell[BoxData[
 RowBox[{
  RowBox[{"summ", "[", 
   RowBox[{"rule_", ",", "exprs_"}], "]"}], ":=", 
  RowBox[{
   RowBox[{"summ", "[", 
    RowBox[{"rule", ",", "exprs"}], "]"}], "=", 
   RowBox[{"Module", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"res", "=", 
       RowBox[{"Flatten", "[", 
        RowBox[{
         RowBox[{"Table", "[", 
          RowBox[{
           RowBox[{"check", "[", 
            RowBox[{"rule", ",", "e", ",", "neg"}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"e", ",", "exprs"}], "}"}], ",", 
           RowBox[{"{", 
            RowBox[{"neg", ",", 
             RowBox[{"{", 
              RowBox[{"True", ",", "False"}], "}"}]}], "}"}]}], "]"}], ",", 
         "1"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"Length", "[", "res", "]"}], ",", 
       RowBox[{"Total", "[", 
        RowBox[{"res", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "1"}], "\[RightDoubleBracket]"}], "]"}], ",", 
       RowBox[{"Total", "[", 
        RowBox[{"res", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "2"}], "\[RightDoubleBracket]"}], "]"}], ",", 
       RowBox[{"Total", "[", 
        RowBox[{"res", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "3"}], "\[RightDoubleBracket]"}], "]"}], ",", 
       RowBox[{"Total", "[", 
        RowBox[{"res", "\[LeftDoubleBracket]", 
         RowBox[{"All", ",", "4"}], "\[RightDoubleBracket]"}], "]"}]}], 
      "}"}]}], "]"}]}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"7ed2d092-bf93-45e4-b9b7-2e1a76ffdf6e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"subs", "[", "e_", "]"}], ":=", 
  RowBox[{"DeleteCases", "[", 
   RowBox[{
    RowBox[{"DeleteDuplicates", "[", 
     RowBox[{"Cases", "[", 
      RowBox[{
       RowBox[{"{", "e", "}"}], ",", 
       RowBox[{
       "_and", "|", "_or", "|", "_not", "|", "p", "|", "q", "|", "r"}], ",", 
       RowBox[{"{", 
        RowBox[{"2", ",", "\[Infinity]"}], "}"}]}], "]"}], "]"}], ",", "e"}], 
   "]"}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"f7a7afa1-a8c9-4f13-b8e8-b48bb4dfc325"],

Cell[BoxData[
 RowBox[{
  RowBox[{"imprecise", "[", 
   RowBox[{"rule_", ",", "exprs_"}], "]"}], ":=", 
  RowBox[{"Module", "[", 
   RowBox[{
    RowBox[{"{", 
     RowBox[{"n", "=", "0"}], "}"}], ",", 
    RowBox[{
     RowBox[{"Do", "[", 
      RowBox[{
       RowBox[{"Module", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"ats", "=", 
            RowBox[{"rule", "[", 
             RowBox[{"e", ",", "neg"}], "]"}]}], ",", 
           RowBox[{"Rb", "=", 
            RowBox[{"req", "[", 
             RowBox[{"e", ",", "neg"}], "]"}]}]}], "}"}], ",", 
         RowBox[{"Do", "[", 
          RowBox[{
           RowBox[{"Module", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{
               RowBox[{"ab", "=", 
                RowBox[{"lit", "[", "at", "]"}]}], ",", 
               RowBox[{"ob", "=", 
                RowBox[{"And", "@@", 
                 RowBox[{"lit", "/@", 
                  RowBox[{"DeleteCases", "[", 
                   RowBox[{"ats", ",", "at", ",", 
                    RowBox[{"{", "1", "}"}], ",", "1"}], "]"}]}]}]}]}], "}"}],
              ",", 
             RowBox[{"If", "[", 
              RowBox[{
               RowBox[{"AnyTrue", "[", 
                RowBox[{
                 RowBox[{"Join", "@@", 
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"{", 
                    RowBox[{
                    RowBox[{"toB", "[", "#1", "]"}], ",", 
                    RowBox[{"!", 
                    RowBox[{"toB", "[", "#1", "]"}]}]}], "}"}], "&"}], ")"}], 
                   "/@", 
                   RowBox[{"subs", "[", 
                    RowBox[{
                    "at", "\[LeftDoubleBracket]", "1", 
                    "\[RightDoubleBracket]"}], "]"}]}]}], ",", 
                 RowBox[{"Function", "[", 
                  RowBox[{"L", ",", 
                   RowBox[{
                    RowBox[{"T", "[", 
                    RowBox[{"Rb", "\[Implies]", "L"}], "]"}], "&&", 
                    RowBox[{"!", 
                    RowBox[{"T", "[", 
                    RowBox[{"ab", "\[Implies]", "L"}], "]"}]}], "&&", 
                    RowBox[{"!", 
                    RowBox[{"T", "[", 
                    RowBox[{"ob", "\[Implies]", "L"}], "]"}]}]}]}], "]"}]}], 
                "]"}], ",", 
               RowBox[{"n", "++"}]}], "]"}]}], "]"}], ",", 
           RowBox[{"{", 
            RowBox[{"at", ",", "ats"}], "}"}]}], "]"}]}], "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"e", ",", "exprs"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"neg", ",", 
         RowBox[{"{", 
          RowBox[{"True", ",", "False"}], "}"}]}], "}"}]}], "]"}], ";", 
     "n"}]}], "]"}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"78f804cc-c7cc-4c3c-9507-fd33c50c85c5"],

Cell[BoxData[
 RowBox[{
  RowBox[{"tbl", "[", 
   RowBox[{"headers_", ",", "rows_"}], "]"}], ":=", 
  RowBox[{"Grid", "[", 
   RowBox[{
    RowBox[{"Prepend", "[", 
     RowBox[{"rows", ",", 
      RowBox[{
       RowBox[{"(", 
        RowBox[{
         StyleBox["#1",
          StripOnInput->False,
          FontWeight->Bold], "&"}], ")"}], "/@", "headers"}]}], "]"}], ",", 
    RowBox[{"Frame", "\[Rule]", "All"}], ",", 
    RowBox[{"Alignment", "\[Rule]", "Left"}], ",", 
    RowBox[{"Background", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"None", ",", 
       RowBox[{"{", 
        TemplateBox[<|"color" -> GrayLevel[0.9]|>,
         "GrayLevelColorSwatchTemplate"], "}"}]}], "}"}]}], ",", 
    RowBox[{"Spacings", "\[Rule]", 
     RowBox[{"{", 
      RowBox[{"1.2`", ",", "0.6`"}], "}"}]}]}], "]"}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"cfade9cf-72c7-41f3-8429-1b07c7d87f1f"],

Cell[BoxData[
 RowBox[{
  RowBox[{"pct", "[", "x_", "]"}], ":=", 
  RowBox[{
   RowBox[{"TextString", "[", 
    RowBox[{"N", "[", 
     RowBox[{"Round", "[", 
      RowBox[{
       RowBox[{"100", " ", "x"}], ",", 
       FractionBox["1", "100"]}], "]"}], "]"}], "]"}], 
   "<>", "\"\< %\>\""}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"24f73f5a-86aa-441e-85a1-9d41a71c90b4"],

Cell[BoxData[
 RowBox[{
  RowBox[{"mark", "[", "b_", "]"}], ":=", 
  RowBox[{"If", "[", 
   RowBox[{
    RowBox[{"TrueQ", "[", "b", "]"}], ",", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<proved\>\"", ",", 
      RowBox[{"Darker", "[", "Green", "]"}]}], "]"}], ",", 
    RowBox[{"Style", "[", 
     RowBox[{"\"\<fails\>\"", ",", "Red"}], "]"}]}], "]"}]}]], "Input",
 InitializationCell->
  True,ExpressionUUID->"633c448f-202d-4a63-b61d-504bdf60c274"]
