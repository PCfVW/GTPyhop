Cell["\<\
Every expression tree of up to 7 nodes over three leaves, binary and ternary \
and/or, each checked as a bail and as a wrapping guard over all 8 assignments.\
\>", "Text",ExpressionUUID->"67586c5e-dbf2-4d6d-9f82-5e5cff3a2544"],

Cell["R4. Precision of the fix + De Morgan rule", "Subsection",ExpressionUUID->"dc00c37c-b225-495e-b814-e9fa277eed10"],

Cell["\<\
An atom counts as imprecise when a strictly stronger literal inside it (a \
sub-expression or its negation) is necessary and is not already implied by \
the sibling atoms: a sounder, more specific blocker the rule does not name.\
\>", "Text",ExpressionUUID->"f357385a-fda6-4551-a9ab-4f20347b0e2e"],

Cell[BoxData[
 RowBox[{
  RowBox[{"distinct", "=", 
   RowBox[{"Select", "[", 
    RowBox[{"all", ",", 
     RowBox[{
      RowBox[{"DuplicateFreeQ", "[", 
       RowBox[{"Cases", "[", 
        RowBox[{
         RowBox[{"{", "#1", "}"}], ",", 
         RowBox[{"p", "|", "q", "|", "r"}], ",", "\[Infinity]"}], "]"}], 
       "]"}], "&"}]}], "]"}]}], ";", 
  RowBox[{"Length", "[", "distinct", "]"}]}]], "Input",ExpressionUUID->\
"5985feda-b3ff-488f-9c54-fa5d202897a9"],

