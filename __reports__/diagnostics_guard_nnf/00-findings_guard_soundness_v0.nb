Cell["\<\
Each shape's success condition is written from the code; the atoms are what \
the ast.walk extractor yields for it.\
\>", "Text",ExpressionUUID->"51d3e2d7-342e-4d63-96da-fbdb2e750e13"],

Cell[BoxData[
 RowBox[{"tbl", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<shape\>\"", ",", "\"\<success condition\>\"", 
     ",", "\"\<extracted atoms\>\"", ",", "\"\<unsound atoms\>\""}], "}"}], ",", 
   RowBox[{"With", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"rows", "=", 
       RowBox[{"{", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{"\"\<if a: if b: return False\>\"", ",", 
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{"p", "&&", "q"}], ")"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"!", "q"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<if a: ...return s;  if b: ...return s\>\"", ",", 
           RowBox[{"p", "||", "q"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", "q"}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<if a: return s;  if b: return False;  return s\>\"", ",", 
           RowBox[{"p", "||", 
            RowBox[{"!", "q"}]}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", 
             RowBox[{"!", "q"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<if a: return False  elif b: return False\>\"", ",", 
           RowBox[{
            RowBox[{"!", "p"}], "&&", 
            RowBox[{"!", "q"}]}], ",", 
           RowBox[{"{", 
            RowBox[{
             RowBox[{"!", "p"}], ",", 
             RowBox[{"!", "q"}]}], "}"}]}], "}"}], ",", 
         RowBox[{"{", 
          RowBox[{"\"\<if a: if b: return s\>\"", ",", 
           RowBox[{"p", "&&", "q"}], ",", 
           RowBox[{"{", 
            RowBox[{"p", ",", "q"}], "}"}]}], "}"}]}], "}"}]}], "}"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}], ",",
             "InputForm"}], "]"}], ",", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{
            "#1", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",",
             "InputForm"}], "]"}], ",", 
          RowBox[{"ToString", "[", 
           RowBox[{
            RowBox[{"Select", "[", 
             RowBox[{
              RowBox[{
              "#1", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}], ",", 
              RowBox[{"Function", "[", 
               RowBox[{"at", ",", 
                RowBox[{"!", 
                 RowBox[{"T", "[", 
                  RowBox[{
                   RowBox[{
                   "#1", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "\[Implies]", "at"}], 
                  "]"}]}]}], "]"}]}], "]"}], ",", "InputForm"}], "]"}]}], 
         "}"}], "&"}], ")"}], "/@", "rows"}]}], "]"}]}], "]"}]], "Input",Expre\
ssionUUID->"73a49982-6cf9-4ad9-aa67-94baa3fc3bd5"],

