Notebook[{
Cell["Guard extraction soundness \[LongDash] Findings (v0)", "Title",ExpressionUUID->"055e825d-b30a-4c8c-a946-35d0043aa45a"],

Cell["\<\
gtpyhop-diagnostics 0.1.0 \[RightArrow] 0.1.1: which atoms explain_dead_end \
may name as blockers\
\>", "Subtitle",ExpressionUUID->"a0c4294f-5a3c-4714-839f-c09a9479b801"],

Cell["\<\
type: findings
topic: diagnostics_guard_nnf
date: 2026-11-16
version: v0
prior-version: none
key-metric: unsound atoms over every guard tree of \[LessEqual] 7 nodes: 0 \
(prior: 28,833 with 0.1.0, delta: \[Minus]28,833)
decision-required: confirm\
\>", "Program",ExpressionUUID->"a2c67245-9e79-406b-a7c8-1ba4da61da6b"],

Cell["Headline Result", "Section",ExpressionUUID->"33bb45ca-3c01-4da1-8451-924b25c73110"],

Cell["\<\
metric:    unsound atoms extracted, every guard expression tree of \
\[LessEqual] 7 nodes over 3 leaves, as a bail and as a wrapping guard
value:     0  (fix only, and fix + De Morgan split)
unit:      atoms
prior:     28,833 (0.1.0)
direction: down\
\>", "Program",ExpressionUUID->"9ef70fde-0833-4a74-9aa2-b29ffa28930e"],

Cell["\<\
decision-required is confirm, for one item: whether to keep commit 3948b54, \
the De Morgan split. Unlike the fix, it changes atoms that were already sound \
(making them finer), so it is kept as a separate commit that can be dropped. \
Everything else is informational.\
\>", "Text",ExpressionUUID->"16d96ced-f9d5-4b39-9833-c69efa488a75"],

Cell["Model", "Section",ExpressionUUID->"f1557334-9196-4be5-80ed-1734dfdae3c2"],

Cell["\<\
An action guard yields a requirement: the test T itself for a wrapping guard \
or an else that bails, and not T for a bail (if T: return False). \
explain_dead_end names as blockers the atoms that evaluate false. That is \
honest only if every atom is necessary, that is implied by the requirement. \
The fix splits the requirement only where it is a conjunction, read through \
negation (its negation normal form):\
\>", "Text",ExpressionUUID->"1f02e0a2-bffd-4c0e-9f49-9c991cf479e8"],

Cell[BoxData[
 TagBox[GridBox[{
    {
     StyleBox["\<\"syntax\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"requirement polarity\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"atoms\"\>",
      StripOnInput->False,
      FontWeight->Bold], 
     StyleBox["\<\"justification\"\>",
      StripOnInput->False,
      FontWeight->Bold]},
    {"\<\"not X\"\>", "\<\"either\"\>", "\<\"atoms of X, polarity flipped \
(kept as written if that splits nothing)\"\>", "\<\"double negation\"\>"},
    {"\<\"A and B and \[Ellipsis]\"\>", "\<\"positive\"\>", "\<\"atoms of \
each operand\"\>", "\<\"a conjunction: each conjunct is necessary\"\>"},
    {"\<\"A or B or \[Ellipsis]\"\>", "\<\"negated\"\>", "\<\"atoms of each \
operand, negated\"\>", "\<\"De Morgan: not (A or B) = not A and not B\"\>"},
    {"\<\"A and B\"\>", "\<\"negated\"\>", "\<\"kept whole\"\>", "\<\"not (A \
and B) = not A or not B: neither is necessary alone\"\>"},
    {"\<\"A or B\"\>", "\<\"positive\"\>", "\<\"kept whole\"\>", "\<\"a \
disjunction: no side is necessary alone\"\>"},
    {"\<\"anything else\"\>", "\<\"either\"\>", "\<\"kept whole\"\>", "\<\"a \
leaf\"\>"}
   },
   AutoDelete->False,
   GridBoxAlignment->{"Columns" -> {{Left}}},
   GridBoxBackground->{"Columns" -> {{None}}, "Rows" -> {
       GrayLevel[0.9]}},
   GridBoxFrame->{"Columns" -> {{True}}, "Rows" -> {{True}}},
   GridBoxItemSize->{"Columns" -> {{Automatic}}, "Rows" -> {{Automatic}}},
   GridBoxSpacings->{"Columns" -> {{1.2}}, "Rows" -> {{0.6}}}],
  "Grid"]], "Output",ExpressionUUID->"cef80415-e717-4b33-8807-b901284a809b"],

Cell["\<\
Worked examples, extracted live by the three rules (A=p, B=q, C=r). An atom \
printed in red is unsound.\
\>", "Text",ExpressionUUID->"4444b4a1-9fb8-4997-b693-283c0744cd82"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"cases", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<bail\>\"", ",", 
         RowBox[{"and", "[", 
          RowBox[{"p", ",", "q"}], "]"}], ",", "True"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<bail\>\"", ",", 
         RowBox[{"not", "[", 
          RowBox[{"and", "[", 
           RowBox[{"p", ",", "q"}], "]"}], "]"}], ",", "True"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<bail\>\"", ",", 
         RowBox[{"or", "[", 
          RowBox[{"p", ",", "q"}], "]"}], ",", "True"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<bail\>\"", ",", 
         RowBox[{"and", "[", 
          RowBox[{"p", ",", 
           RowBox[{"or", "[", 
            RowBox[{"q", ",", "r"}], "]"}]}], "]"}], ",", "True"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<wrap\>\"", ",", 
         RowBox[{"and", "[", 
          RowBox[{"p", ",", 
           RowBox[{"or", "[", 
            RowBox[{"q", ",", "r"}], "]"}]}], "]"}], ",", "False"}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<wrap\>\"", ",", 
         RowBox[{"and", "[", 
          RowBox[{
           RowBox[{"not", "[", 
            RowBox[{"or", "[", 
             RowBox[{"p", ",", "q"}], "]"}], "]"}], ",", 
           RowBox[{"not", "[", "r", "]"}]}], "]"}], ",", "False"}], "}"}]}], 
      "}"}]}], "}"}], ",", 
   RowBox[{"tbl", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<guard\>\"", ",", "\"\<test\>\"", ",", "\"\<requirement\>\"",
        ",", "\"\<0.1.0\>\"", ",", "\"\<fix (185a327)\>\"", 
       ",", "\"\<fix + De Morgan (3948b54)\>\""}], "}"}], ",", 
     RowBox[{"Table", "[", 
      RowBox[{
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"e", "=", 
            RowBox[{
            "c", "\[LeftDoubleBracket]", "2", "\[RightDoubleBracket]"}]}], ",", 
           RowBox[{"neg", "=", 
            RowBox[{
            "c", "\[LeftDoubleBracket]", "3", "\[RightDoubleBracket]"}]}]}], 
          "}"}], ",", 
         RowBox[{"{", 
          RowBox[{
           RowBox[{
           "c", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
           RowBox[{"show", "[", "e", "]"}], ",", 
           RowBox[{"ToString", "[", 
            RowBox[{
             RowBox[{"BooleanMinimize", "[", 
              RowBox[{"req", "[", 
               RowBox[{"e", ",", "neg"}], "]"}], "]"}], ",", "InputForm"}], 
            "]"}], ",", 
           RowBox[{"Sequence", "@@", 
            RowBox[{
             RowBox[{"(", 
              RowBox[{
               RowBox[{"Row", "[", 
                RowBox[{"Riffle", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{"(", 
                    RowBox[{
                    RowBox[{"If", "[", 
                    RowBox[{
                    RowBox[{"T", "[", 
                    RowBox[{
                    RowBox[{"req", "[", 
                    RowBox[{"e", ",", "neg"}], "]"}], "\[Implies]", 
                    RowBox[{"lit", "[", "#1", "]"}]}], "]"}], ",", 
                    RowBox[{"showAtom", "[", "#1", "]"}], ",", 
                    RowBox[{"Style", "[", 
                    RowBox[{
                    RowBox[{"showAtom", "[", "#1", "]"}], ",", "Red"}], 
                    "]"}]}], "]"}], "&"}], ")"}], "/@", "#1"}], 
                  ",", "\"\<,  \>\""}], "]"}], "]"}], "&"}], ")"}], "/@", 
             RowBox[{"{", 
              RowBox[{
               RowBox[{"old", "[", 
                RowBox[{"e", ",", "neg"}], "]"}], ",", 
               RowBox[{"cons", "[", 
                RowBox[{"e", ",", "neg"}], "]"}], ",", 
               RowBox[{"nnf", "[", 
                RowBox[{"e", ",", "neg"}], "]"}]}], "}"}]}]}]}], "}"}]}], 
        "]"}], ",", 
       RowBox[{"{", 
        RowBox[{"c", ",", "cases"}], "}"}]}], "]"}]}], "]"}]}], 
  "]"}]], "Input",ExpressionUUID->"421b70ae-2864-4b5a-935b-bee639257b57"],

