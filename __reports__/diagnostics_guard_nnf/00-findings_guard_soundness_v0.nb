Cell["Results Tables", "Section",ExpressionUUID->"25c87fe5-2545-422b-b35f-86f144b767a2"],

Cell["R1. The root cause and the table rows of the issue draft", "Subsection",ExpressionUUID->"63eca06b-5bb1-40fe-966e-9f1deb7eb5ff"],

Cell[BoxData[
 RowBox[{"tbl", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"\"\<claim\>\"", ",", "\"\<statement\>\"", 
     ",", "\"\<result\>\""}], "}"}], ",", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<L1 double negation\>\"", 
       ",", "\"\<!!a \[DoubleLongLeftRightArrow] a\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"!", "p"}]}], "\[Equivalent]", "p"}], "]"}], "]"}]}], 
      "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<L2 De Morgan (and)\>\"", 
       ",", "\"\<!(a && b) \[DoubleLongLeftRightArrow] !a || !b\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{"p", "&&", "q"}], ")"}]}], "\[Equivalent]", 
          RowBox[{
           RowBox[{"!", "p"}], "||", 
           RowBox[{"!", "q"}]}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<L3 De Morgan (or)\>\"", 
       ",", "\"\<!(a || b) \[DoubleLongLeftRightArrow] !a && !b\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{"p", "||", "q"}], ")"}]}], "\[Equivalent]", 
          RowBox[{
           RowBox[{"!", "p"}], "&&", 
           RowBox[{"!", "q"}]}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<L4 n-ary De Morgan\>\"", 
       ",", "\"\<n = 1 \[Ellipsis] 10\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"AllTrue", "[", 
         RowBox[{
          RowBox[{"Range", "[", "10", "]"}], ",", 
          RowBox[{
           RowBox[{"With", "[", 
            RowBox[{
             RowBox[{"{", 
              RowBox[{"xs", "=", 
               RowBox[{"Array", "[", 
                RowBox[{"x", ",", "#1"}], "]"}]}], "}"}], ",", 
             RowBox[{"TautologyQ", "[", 
              RowBox[{
               RowBox[{
                RowBox[{"!", 
                 RowBox[{"Or", "@@", "xs"}]}], "\[Equivalent]", 
                RowBox[{"And", "@@", 
                 RowBox[{"Not", "/@", "xs"}]}]}], ",", "xs"}], "]"}]}], "]"}],
            "&"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<root cause\>\"", 
       ",", "\"\<!(a && b) \[DoubleLongRightArrow] !a\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"T", "[", 
         RowBox[{
          RowBox[{"!", 
           RowBox[{"(", 
            RowBox[{"p", "&&", "q"}], ")"}]}], "\[Implies]", 
          RowBox[{"!", "p"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<  counterexample\>\"", ",", "\"\<\>\"", ",", 
       RowBox[{"FindInstance", "[", 
        RowBox[{
         RowBox[{"!", 
          RowBox[{"(", 
           RowBox[{
            RowBox[{"!", 
             RowBox[{"(", 
              RowBox[{"p", "&&", "q"}], ")"}]}], "\[Implies]", 
            RowBox[{"!", "p"}]}], ")"}]}], ",", 
         RowBox[{"{", 
          RowBox[{"p", ",", "q"}], "}"}], ",", "Booleans"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<row 2: bail on a && b\>\"", 
       ",", "\"\<no single literal of a, b is necessary\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"NoneTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"p", ",", 
            RowBox[{"!", "p"}], ",", "q", ",", 
            RowBox[{"!", "q"}]}], "}"}], ",", 
          RowBox[{
           RowBox[{"T", "[", 
            RowBox[{
             RowBox[{"!", 
              RowBox[{"(", 
               RowBox[{"p", "&&", "q"}], ")"}]}], "\[Implies]", "#1"}], "]"}],
            "&"}]}], "]"}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<row 3: bail on a || b\>\"", 
       ",", "\"\<!a and !b each necessary, jointly sufficient\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{
         RowBox[{"T", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{"p", "||", "q"}], ")"}]}], "\[Implies]", 
           RowBox[{"!", "p"}]}], "]"}], "&&", 
         RowBox[{"T", "[", 
          RowBox[{
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{"p", "||", "q"}], ")"}]}], "\[Implies]", 
           RowBox[{"!", "q"}]}], "]"}], "&&", 
         RowBox[{"T", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"!", "p"}], "&&", 
            RowBox[{"!", "q"}]}], "\[Equivalent]", 
           RowBox[{"!", 
            RowBox[{"(", 
             RowBox[{"p", "||", "q"}], ")"}]}]}], "]"}]}], "]"}]}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{"\"\<row 4: wrap a && (b || c)\>\"", 
       ",", "\"\<b || c cannot be narrowed to b or c\>\"", ",", 
       RowBox[{"mark", "[", 
        RowBox[{"NoneTrue", "[", 
         RowBox[{
          RowBox[{"{", 
           RowBox[{"q", ",", 
            RowBox[{"!", "q"}], ",", "r", ",", 
            RowBox[{"!", "r"}]}], "}"}], ",", 
          RowBox[{
           RowBox[{"T", "[", 
            RowBox[{
             RowBox[{"p", "&&", 
              RowBox[{"(", 
               RowBox[{"q", "||", "r"}], ")"}]}], "\[Implies]", "#1"}], "]"}],
            "&"}]}], "]"}], "]"}]}], "}"}]}], "}"}]}], "]"}]], "Input",Express\
ionUUID->"ac214734-444a-44fe-a83a-b42e03578200"],

