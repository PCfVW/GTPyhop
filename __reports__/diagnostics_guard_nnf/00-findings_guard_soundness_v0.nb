Cell["\<\
The \"fails\" on the root-cause line is the defect: a bail on a conjunction \
does not require the negation of either conjunct. The counterexample is the \
reproduction's own state.\
\>", "Text",ExpressionUUID->"0586fb35-9460-4fa7-aae5-8a5e0f81c10c"],

Cell["\<\
R2. Proof for every expression, by induction on the syntax tree\
\>", "Subsection",ExpressionUUID->"0dd6bd8f-fc58-4c5d-a71c-bb54ad8e018c"],

Cell["\<\
Claim: for every test e and polarity, the conjunction of the extracted atoms \
is equivalent to the requirement. Each clause of the rule is shown to \
preserve this, assuming it for the children (IH: Ai \
\[DoubleLongLeftRightArrow] Ri). Equivalence then gives necessity of every \
atom by and-elimination.\
\>", "Text",ExpressionUUID->"bb436df1-e8a6-472a-9c38-eb8530513221"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"step", "=", 
     RowBox[{"Function", "[", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"n", ",", "comb"}], "}"}], ",", 
       RowBox[{"With", "[", 
        RowBox[{
         RowBox[{"{", 
          RowBox[{
           RowBox[{"A", "=", 
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{
               SubscriptBox["aa", "#1"], "&"}], ",", "n"}], "]"}]}], ",", 
           RowBox[{"R", "=", 
            RowBox[{"Array", "[", 
             RowBox[{
              RowBox[{
               SubscriptBox["rr", "#1"], "&"}], ",", "n"}], "]"}]}]}], "}"}], 
         ",", 
         RowBox[{"TautologyQ", "[", 
          RowBox[{
           RowBox[{
            RowBox[{"And", "@@", 
             RowBox[{"MapThread", "[", 
              RowBox[{"Equivalent", ",", 
               RowBox[{"{", 
                RowBox[{"A", ",", "R"}], "}"}]}], "]"}]}], "\[Implies]", 
            RowBox[{
             RowBox[{"And", "@@", "A"}], "\[Equivalent]", 
             RowBox[{"comb", "[", "R", "]"}]}]}], ",", 
           RowBox[{"Join", "[", 
            RowBox[{"A", ",", "R"}], "]"}]}], "]"}]}], "]"}]}], "]"}]}], 
    "}"}], ",", 
   RowBox[{"tbl", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<clause of the rule\>\"", ",", "\"\<obligation\>\"", 
       ",", "\"\<result\>\""}], "}"}], ",", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"{", 
        RowBox[{"\"\<not x, negated\>\"", 
         ",", "\"\<req(not x, True) \[DoubleLongLeftRightArrow] req(x, False)\
\>\"", ",", 
         RowBox[{"mark", "[", 
          RowBox[{"TautologyQ", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", 
              RowBox[{"!", "x"}]}], "\[Equivalent]", "x"}], ",", 
            RowBox[{"{", "x", "}"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<not x, positive\>\"", 
         ",", "\"\<req(not x, False) \[DoubleLongLeftRightArrow] req(x, True)\
\>\"", ",", 
         RowBox[{"mark", "[", 
          RowBox[{"TautologyQ", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", "x"}], "\[Equivalent]", 
             RowBox[{"!", "x"}]}], ",", 
            RowBox[{"{", "x", "}"}]}], "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<and[v1..vn], positive\>\"", 
         ",", "\"\<AND(atoms of children) \[DoubleLongLeftRightArrow] \
And(vi), n = 2 \[Ellipsis] 7\>\"", ",", 
         RowBox[{"mark", "[", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"2", ",", "7"}], "]"}], ",", 
            RowBox[{
             RowBox[{"step", "[", 
              RowBox[{"#1", ",", 
               RowBox[{
                RowBox[{"And", "@@", "#1"}], "&"}]}], "]"}], "&"}]}], "]"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<or[v1..vn], negated\>\"", 
         ",", "\"\<AND(atoms of children, each req = !vi) \
\[DoubleLongLeftRightArrow] !Or(vi), n = 2 \[Ellipsis] 7\>\"", ",", 
         RowBox[{"mark", "[", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Range", "[", 
             RowBox[{"2", ",", "7"}], "]"}], ",", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{
                 RowBox[{"V", "=", 
                  RowBox[{"Array", "[", 
                   RowBox[{
                    RowBox[{
                    SubscriptBox["vv", "#1"], "&"}], ",", "#1"}], "]"}]}], ",", 
                 RowBox[{"A", "=", 
                  RowBox[{"Array", "[", 
                   RowBox[{
                    RowBox[{
                    SubscriptBox["aa", "#1"], "&"}], ",", "#1"}], "]"}]}]}], 
                "}"}], ",", 
               RowBox[{"TautologyQ", "[", 
                RowBox[{
                 RowBox[{
                  RowBox[{"And", "@@", 
                   RowBox[{"MapThread", "[", 
                    RowBox[{"Equivalent", ",", 
                    RowBox[{"{", 
                    RowBox[{"A", ",", 
                    RowBox[{"Not", "/@", "V"}]}], "}"}]}], "]"}]}], "\[Implies]", 
                  RowBox[{
                   RowBox[{"And", "@@", "A"}], "\[Equivalent]", 
                   RowBox[{"!", 
                    RowBox[{"Or", "@@", "V"}]}]}]}], ",", 
                 RowBox[{"Join", "[", 
                  RowBox[{"A", ",", "V"}], "]"}]}], "]"}]}], "]"}], "&"}]}], 
           "]"}], "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<kept whole\>\"", 
         ",", "\"\<the single atom is the requirement\>\"", ",", 
         RowBox[{"mark", "[", "True", "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<necessity\>\"", 
         ",", "\"\<req \[DoubleLongLeftRightArrow] AND(atoms) \
\[DoubleLongRightArrow] each atom, n = 1 \[Ellipsis] 7\>\"", ",", 
         RowBox[{"mark", "[", 
          RowBox[{"AllTrue", "[", 
           RowBox[{
            RowBox[{"Range", "[", "7", "]"}], ",", 
            RowBox[{
             RowBox[{"With", "[", 
              RowBox[{
               RowBox[{"{", 
                RowBox[{"A", "=", 
                 RowBox[{"Array", "[", 
                  RowBox[{
                   RowBox[{
                    SubscriptBox["aa", "#1"], "&"}], ",", "#1"}], "]"}]}], 
                "}"}], ",", 
               RowBox[{"AllTrue", "[", 
                RowBox[{"A", ",", 
                 RowBox[{"Function", "[", 
                  RowBox[{"ai", ",", 
                   RowBox[{"TautologyQ", "[", 
                    RowBox[{
                    RowBox[{
                    RowBox[{"And", "@@", "A"}], "\[Implies]", "ai"}], ",", 
                    "A"}], "]"}]}], "]"}]}], "]"}]}], "]"}], "&"}]}], "]"}], 
          "]"}]}], "}"}], ",", 
       RowBox[{"{", 
        RowBox[{"\"\<0.1.0's bail clause\>\"", 
         ",", "\"\<AND(!a, !b) \[DoubleLongLeftRightArrow] !(a && b)\>\"", ",", 
         RowBox[{"mark", "[", 
          RowBox[{"T", "[", 
           RowBox[{
            RowBox[{
             RowBox[{"!", "p"}], "&&", 
             RowBox[{"!", "q"}]}], "\[Equivalent]", 
            RowBox[{"!", 
             RowBox[{"(", 
              RowBox[{"p", "&&", "q"}], ")"}]}]}], "]"}], "]"}]}], "}"}]}], 
      "}"}]}], "]"}]}], "]"}]], "Input",ExpressionUUID->"887e2069-6257-4a62-\
acef-9b46a19fea5e"],

