Cell["\<\
The draft's example: the requirement implies q, but the atom (r || q) alone \
does not, so finding q takes reasoning across atoms.\
\>", "Text",ExpressionUUID->"bb4d48ad-aa8a-43d8-af73-92b3f0eb768a"],

Cell["R5. The reported reproduction", "Subsection",ExpressionUUID->"7310e109-d441-4bf1-9024-0e9675907181"],

Cell["\<\
p = state.locked_a[x] = True, q = state.locked_b[x] = False, r = \
(state.fuel[x] > 0) = False; guards: bail on p && q, bail on !r.\
\>", "Text",ExpressionUUID->"dabcd0bd-07ac-4dfe-bae7-59234b4305cf"],

Cell[BoxData[
 RowBox[{"With", "[", 
  RowBox[{
   RowBox[{"{", 
    RowBox[{"s", "=", 
     RowBox[{"{", 
      RowBox[{
       RowBox[{"p", "\[Rule]", "True"}], ",", 
       RowBox[{"q", "\[Rule]", "False"}], ",", 
       RowBox[{"r", "\[Rule]", "False"}]}], "}"}]}], "}"}], ",", 
   RowBox[{"tbl", "[", 
    RowBox[{
     RowBox[{"{", 
      RowBox[{"\"\<extractor\>\"", ",", "\"\<atoms named as blockers\>\""}], 
      "}"}], ",", 
     RowBox[{
      RowBox[{"(", 
       RowBox[{
        RowBox[{"{", 
         RowBox[{
          RowBox[{
          "#1", "\[LeftDoubleBracket]", "1", "\[RightDoubleBracket]"}], ",", 
          RowBox[{"Row", "[", 
           RowBox[{"Riffle", "[", 
            RowBox[{
             RowBox[{"showAtom", "/@", 
              RowBox[{"Select", "[", 
               RowBox[{
                RowBox[{"Join", "[", 
                 RowBox[{
                  RowBox[{
                   RowBox[{
                   "#1", "\[LeftDoubleBracket]", "2", 
                    "\[RightDoubleBracket]"}], "[", 
                   RowBox[{
                    RowBox[{"and", "[", 
